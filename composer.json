{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "odessa/pos",
    "type": "project",
    "description": "Odessa POS universal point-of-sale system.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "^3.1",
        "endroid/qr-code": "6.*",
        "laravel/fortify": "^1.40",
        "laravel/framework": "^12.0",
        "maatwebsite/excel": "3.1.*",
        "picqer/php-barcode-generator": "^3.3",
        "spatie/laravel-activitylog": "4.*",
        "spatie/laravel-medialibrary": "11.*",
        "spatie/laravel-permission": "6.*",
        "yajra/laravel-datatables-oracle": "12.*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "3.*",
        "laravel/pint": "1.30.4",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "3.*",
        "pestphp/pest-plugin-laravel": "3.*",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names=server,queue,vite"
        ],
        "test": "@pest",
        "phpstan": "@php vendor/bin/phpstan analyse --memory-limit=2G",
        "format": "@php vendor/bin/pint"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "12.x-dev"
        },
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.0"
        },
        "platform-check": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
